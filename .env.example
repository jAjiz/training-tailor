# PostgreSQL (Neon). Use your own dev branch, never production.
# Pooled connection (host ends in -pooler): used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Direct connection (same host without -pooler): used by the Prisma CLI
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# AI provider: "gemini" (v1). The model is pinned: change it only deliberately, then run `pnpm eval`.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Optional: model for the coach PDF import (default gemini-3.8-flash; lite models misread multi-page layouts)
GEMINI_IMPORT_MODEL=

# Better Auth (Google OAuth)
# Secret: 32+ random bytes, base64 — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the app (the production URL on Vercel)
BETTER_AUTH_URL="http://localhost:3000"
# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Engine runs (tailor + refine) allowed per user per rolling 24 h
DAILY_ENGINE_LIMIT="30"

# Athlete sign-up: "invite_only" (a coach program link is required) or "open"
ATHLETE_SIGNUP=invite_only

# Web push (optional). Without the VAPID keys the app is inbox only. `pnpm push:keys` generates the pair.
# NEXT_PUBLIC_* is inlined at build time: on Vercel, redeploy after setting it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for the push services, a mailto: address
VAPID_SUBJECT="mailto:you@example.com"
# Bearer secret that authorizes the Sunday reminder cron route
CRON_SECRET=""
# "on" (default) shows the install-the-app page to phones in a browser tab; "off" disables it
INSTALL_GATE=on

# Host of the dev database (the DATABASE_URL host); `pnpm domain:import` refuses any other
DOMAIN_IMPORT_HOST=
